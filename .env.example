# Supabase Cloud project URL and publishable key (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use the same project URL for the server-side Auth proxy.
SUPABASE_INTERNAL_URL=https://<project-ref>.supabase.co

# Supabase Cloud Postgres session-pooler URI (Project > Connect > Session pooler).
# Keep DATABASE_URL pointed at the legacy database until data migration is complete.
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=D%3A%5CGames%5Crrr%5Csupabase-root.crt
